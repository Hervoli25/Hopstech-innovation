# Database - Neon PostgreSQL
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# Email Configuration (Required for Magic Link Authentication)
EMAIL_USER="your-email@zoho.com"
EMAIL_PASS="your-app-specific-password"
EMAIL_HOST="smtp.zoho.eu"
EMAIL_PORT="587"
EMAIL_FROM="noreply@yourdomain.com"

# Application
APP_ID="hopstech-portfolio"
VITE_APP_ID="hopstech-portfolio"
VITE_APP_TITLE="HOPSTECH INNOVATION"
VITE_APP_LOGO="/logo.png"

# Session & Authentication (Required for Client Portal)
SESSION_SECRET="your-random-secret-key-min-32-chars"
JWT_SECRET="your-jwt-secret-key-min-32-chars"

# Application URL (for magic link emails)
APP_URL="http://localhost:5000"
# For production: APP_URL="https://yourdomain.com"

# Analytics (Optional)
VITE_ANALYTICS_ENDPOINT=""
VITE_ANALYTICS_WEBSITE_ID=""

# Node Environment
NODE_ENV="development"
# For production: NODE_ENV="production"

